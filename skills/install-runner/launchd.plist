<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/Library/LaunchAgents/sh.collies.claude-rc.NAME.plist: replace NAME, SCRIPT, REPO_DIR and HOME. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>sh.collies.claude-rc.NAME</string>
	<key>ProgramArguments</key>
	<array>
		<string>SCRIPT</string>
		<string>NAME</string>
		<string>REPO_DIR</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>HOME/.local/state/claude-rc/NAME.log</string>
	<key>StandardErrorPath</key>
	<string>HOME/.local/state/claude-rc/NAME.log</string>
</dict>
</plist>
