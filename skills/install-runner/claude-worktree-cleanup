#!/bin/bash
# Cleans up after the collie runner's sessions in one repo. Installed by the collie plugin's install-runner skill and
# run every hour by launchd (macOS) or a systemd --user timer (Linux).
#
# Usage: claude-worktree-cleanup [--dry-run] <repo-dir> [prompt-prefix ...]
#
# `claude rc --spawn worktree` never ends a session on its own and never removes its worktree, so every run leaves a
# live process and a checkout in <repo-dir>/.claude/worktrees/bridge-cse_<id>. For each of those worktrees:
#   1. Runner sessions are those whose first prompt starts with one of the prefixes (default: the collie worker
#      prompt). A live session someone opened by hand through the same bridge is never touched.
#   2. Skip it if it is still active: a live runner session whose transcript changed in the last $IDLE_HOURS hours
#      (default 2); a runner session whose process is gone (archived from Claude, or crashed) only for its first 10
#      minutes; a session opened by hand whose process is gone, for $MANUAL_IDLE_HOURS hours (default 24), in case it
#      can be resumed or left files git ignores.
#   3. Stop the session's process and every process still running inside the worktree (dev servers, watchers and test
#      runs a session started in the background outlive it and pile up until the machine runs out of memory).
#   4. Remove the worktree only if it has no changes (caches like __pycache__ and untracked symlinks such as a linked
#      node_modules do not count) and no commits missing from the remotes, plus its throwaway worktree-bridge-* branch. Anything else is kept and
#      logged, for a person to look at.
# Before that, for every bridge worktree (runner or not) whose session process is gone (no bridge process and no claude
# working inside it, so a session resumed by hand with `claude --resume` counts as alive), it stops the processes still
# running inside it: with their session gone they are orphans nobody will stop.

set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

dry=0
if [[ ${1:-} == --dry-run ]]; then dry=1; shift; fi
if [[ $# -lt 1 ]]; then
  echo "usage: $0 [--dry-run] <repo-dir> [prompt-prefix ...]" >&2
  exit 2
fi
main=${1%/}; shift
# (Not an empty array plus a default: macOS ships bash 3.2, where an empty array trips set -u.)
if [[ $# -eq 0 ]]; then prefixes=("You are collie's worker for this repo."); else prefixes=("$@"); fi
idle_hours=${IDLE_HOURS:-2}
manual_idle_hours=${MANUAL_IDLE_HOURS:-24}
gone_grace_s=600

log() { echo "$(date '+%F %T') $*"; }
run() { if (( dry )); then log "  (dry-run) $*"; else "$@"; fi; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1"; }

# Claude Code keeps a session's transcripts in ~/.claude/projects/<cwd with every non-alphanumeric char as ->.
transcript_dir() { echo "$HOME/.claude/projects/$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"; }

first_prompt() {
  jq -r 'select(.type=="user" and (.message.content|type)=="string") | .message.content' "$1" 2>/dev/null | head -1
}

is_runner_prompt() {
  local p
  for p in "${prefixes[@]}"; do
    [[ $1 == "$p"* ]] && return 0
  done
  return 1
}

# Untracked files a session leaves just by running things, which nobody would want back.
is_cache() {
  case $1 in
    __pycache__/|*/__pycache__/|*.pyc|.pytest_cache/|*/.pytest_cache/|.DS_Store|*/.DS_Store) return 0 ;;
  esac
  return 1
}

# Changed or untracked entries, leaving out caches and untracked symlinks (a node_modules linked by a setup hook).
dirty_count() {
  local wt=$1 n=0 line path
  while IFS= read -r line; do
    path=${line:3}
    if [[ $line == '?? '* ]]; then
      is_cache "$path" && continue
      [[ -L $wt/${path%/} ]] && continue
    fi
    n=$((n + 1))
  done < <(git -C "$wt" status --porcelain 2>/dev/null)
  echo $n
}

# Processes whose working directory is the worktree or inside it. Uses the pid/cwd table read once per run.
pids_in() {
  awk -v wt="$1" -F'\t' '$2 == wt || index($2, wt "/") == 1 { print $1 }' "$cwd_table"
}

# Whether the worktree's session is still running: the bridge's own process (--session-id cse_<id>), or any Claude Code
# process working inside it, such as the session resumed by hand with `claude --resume` after its bridge process died,
# which carries no cse id.
session_alive() {
  local id=$1 wt=$2 p
  pgrep -f "session-id cse_$id" >/dev/null && return 0
  for p in $(pids_in "$wt"); do
    ps -o args= -p "$p" 2>/dev/null | grep -Eq '(^|/)claude( |$)|/claude/versions/' && return 0
  done
  return 1
}

# TERM, then KILL whatever is still alive a few seconds later.
stop_pids() {
  local pids=$*
  [[ -z ${pids// } ]] && return
  run kill $pids 2>/dev/null
  (( dry )) && return
  sleep 3
  local left=""
  for p in $pids; do kill -0 "$p" 2>/dev/null && left="$left $p"; done
  [[ -n $left ]] && kill -9 $left 2>/dev/null
}

command -v jq >/dev/null || { log "jq is required"; exit 1; }
[[ -d $main/.git ]] || { log "$main is not a git checkout"; exit 1; }

now=$(date +%s)
removed=0; kept=0

# pid<TAB>cwd for the user's processes (lsof prints p<pid> then n<path> lines).
cwd_table=$(mktemp)
trap 'rm -f "$cwd_table"' EXIT
lsof -a -u "$(id -u)" -d cwd -Fpn 2>/dev/null | awk '/^p/ { pid = substr($0, 2) } /^n/ { print pid "\t" substr($0, 2) }' > "$cwd_table"

shopt -s nullglob

# Orphans: processes left inside a bridge worktree whose session process is gone.
for wt in "$main"/.claude/worktrees/bridge-cse_*/; do
  wt=${wt%/}
  id=${wt##*bridge-cse_}
  session_alive "$id" "$wt" && continue
  orphans=$(pids_in "$wt" | tr '\n' ' ')
  [[ -z ${orphans// } ]] && continue
  log "orphans in $id (session gone): stop pid $orphans"
  stop_pids $orphans
done

for wt in "$main"/.claude/worktrees/bridge-cse_*/; do
  wt=${wt%/}
  id=${wt##*bridge-cse_}
  transcript=$(ls -t "$(transcript_dir "$wt")"/*.jsonl 2>/dev/null | head -1)
  runner=1
  if [[ -n $transcript ]]; then
    is_runner_prompt "$(first_prompt "$transcript")" || runner=0
    age_s=$(( now - $(mtime "$transcript") ))
  else
    # Spawned but never prompted: there is no transcript, so age it by the worktree.
    age_s=$(( now - $(mtime "$wt/.git") ))
  fi
  age_h=$(( age_s / 3600 ))
  if session_alive "$id" "$wt"; then
    # A live session: only runner sessions, once idle.
    (( runner )) || continue
    if (( age_h < idle_hours )); then log "skip $id: active ${age_h}h ago"; continue; fi
  elif (( runner )); then
    # Session gone (archived or crashed): nothing can resume it, so no idle wait, only a short grace for a worktree
    # whose session is still starting.
    if (( age_s < gone_grace_s )); then log "skip $id: session gone ${age_s}s ago"; continue; fi
  else
    # A session opened by hand whose process is gone: archived, crashed or cut by a bridge restart. Wait longer, in
    # case it can still be resumed or left something git ignores (.env, logs, screenshots).
    if (( age_h < manual_idle_hours )); then log "skip $id: manual session gone, active ${age_h}h ago"; continue; fi
  fi

  pids=$( { pgrep -f "session-id cse_$id"; pids_in "$wt"; } | sort -u | tr '\n' ' ')
  if [[ -n ${pids// } ]]; then
    log "stop $id (pid $pids)"
    stop_pids $pids
  fi

  dirty=$(dirty_count "$wt")
  unpushed=$(git -C "$wt" rev-list --count HEAD --not --remotes 2>/dev/null || echo '?')
  if [[ $dirty != 0 || $unpushed != 0 ]]; then
    log "KEEP $id: dirty=$dirty unpushed=$unpushed"
    kept=$((kept + 1)); continue
  fi

  branch=$(git -C "$wt" branch --show-current)
  run git -C "$main" worktree unlock "$wt" 2>/dev/null
  if run git -C "$main" worktree remove --force "$wt"; then
    [[ $branch == worktree-bridge-* ]] && run git -C "$main" branch -D -q "$branch"
    log "removed $id (${branch:-detached}, idle ${age_h}h)"
    removed=$((removed + 1))
  else
    log "KEEP $id: git worktree remove failed"
    kept=$((kept + 1))
  fi
done

run git -C "$main" worktree prune
log "done in $main: removed=$removed kept=$kept"
